// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductVariantStatus {
  ACTIVE
  ARCHIVED
}

enum VendorStatus {
  ACTIVE
  INACTIVE
}

enum CustomRequestStatus {
  SUBMITTED
  REVIEWING
  QUOTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RequestOccasion {
  WEDDING
  BUSINESS
  FUNERAL
  CHURCH
  OTHER
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer?
  admin    Admin?
  vendor   Vendor?
}

model Customer {
  id        String   @id @default(cuid())
  userId    String   @unique
  phone     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  customRequests CustomRequest[]
}

model Admin {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Vendor {
  id           String       @id @default(cuid())
  userId       String       @unique
  businessName String
  contactInfo  String?
  status       VendorStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  products Product[]

  @@index([status])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Brand {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  logoRef     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Category {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  parentCategoryId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  parentCategory    Category?         @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  subCategories     Category[]        @relation("CategoryHierarchy")
  productCategories ProductCategory[]

  @@index([parentCategoryId])
}

model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  status      ProductStatus @default(DRAFT)
  brandId     String
  vendorId    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  brand      Brand             @relation(fields: [brandId], references: [id])
  vendor     Vendor            @relation(fields: [vendorId], references: [id])
  variants   ProductVariant[]
  images     ProductImage[]
  categories ProductCategory[]

  @@index([brandId])
  @@index([vendorId])
  @@index([status])
}

// Join table for Product <-> Category (many-to-many), carrying isPrimary.
// "At most one primary category per product" cannot be expressed here
// (a plain @@unique on [productId, isPrimary] would also block a product
// from having more than one non-primary category). Enforced instead by
// a partial unique index added in the initial migration:
//   CREATE UNIQUE INDEX product_category_one_primary
//     ON "ProductCategory" ("productId")
//     WHERE "isPrimary" = true;
model ProductCategory {
  productId  String
  categoryId String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product  Product  @relation(fields: [productId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductVariant {
  id        String               @id @default(cuid())
  productId String
  size      String
  color     String
  sku       String               @unique
  price     Decimal              @db.Decimal(12, 2)
  stock     Int                  @default(0)
  status    ProductVariantStatus @default(ACTIVE)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  product        Product         @relation(fields: [productId], references: [id])
  customRequests CustomRequest[]

  @@index([productId])
  @@index([status])
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  storageRef String
  altText    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Custom Orders
// ---------------------------------------------------------------------------

model CustomRequest {
  id               String              @id @default(cuid())
  customerId       String?
  contactName      String
  contactPhone     String
  contactWhatsapp  String?
  productVariantId String?
  size             String?
  occasion         RequestOccasion?
  status           CustomRequestStatus @default(SUBMITTED)
  description      String
  budgetMin        Decimal?            @db.Decimal(12, 2)
  budgetMax        Decimal?            @db.Decimal(12, 2)
  measurements     Json
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  customer       Customer?            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  productVariant ProductVariant?      @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  images         CustomRequestImage[]

  @@index([customerId])
  @@index([status])
  @@index([productVariantId])
}

model CustomRequestImage {
  id              String   @id @default(cuid())
  customRequestId String
  storageRef      String
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customRequest CustomRequest @relation(fields: [customRequestId], references: [id])

  @@index([customRequestId])
}
